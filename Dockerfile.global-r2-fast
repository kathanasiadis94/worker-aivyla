# Isolated Aivyla Global FastStart test image; production unaffected.
FROM ghcr.io/kathanasiadis94/worker-aivyla:aivyla-global-v3

RUN python -m pip install --no-cache-dir 'boto3>=1.34,<2' \
 && python -m pip check

# Existing R2/CDN/FastStart bootstrap, node staging and model staging.
COPY aivyla_r2_registry.py aivyla_r2_stage.py aivyla_cdn_stage.py aivyla_cdn_v2_stage.py aivyla_r2_nodes.py aivyla_global_r2_handler.py aivyla_global_r2_start.py aivyla_global_nodes.py aivyla_fast_requirements.py aivyla_fast_start.py /opt/aivyla-global/

# Trusted SHA256 receipts from the already verified USA bucket.
# Pinned into the image: staging no longer GETs one JSON per known model.
COPY aivyla_trusted_receipts.json /opt/aivyla-global/aivyla_trusted_receipts.json
RUN python - <<'PYVERIFY'
import json
from pathlib import Path
p = Path('/opt/aivyla-global/aivyla_trusted_receipts.json')
m = json.loads(p.read_text())
assert m.get('schema') == 1 and m.get('bucket') == 'aivyla-models-usa'
assert isinstance(m.get('models'), dict) and len(m['models']) >= 90
for key, item in m['models'].items():
    assert key.startswith('models/') and key.endswith(('.safetensors', '.gguf', '.ckpt', '.pt', '.pth', '.bin', '.onnx', '.sft'))
    assert type(item.get('bytes')) is int and item['bytes'] >= 8
    sha = item.get('sha256')
    assert isinstance(sha, str) and len(sha) == 64 and all(c in '0123456789abcdef' for c in sha)
print('Aivyla trusted SHA256 manifest verified:', len(m['models']), 'models')
PYVERIFY

# Preserve the Global-only preview-aware handler.
COPY handler.py aivyla_preview.py aivyla_output_upload.py /

RUN python -m py_compile /opt/aivyla-global/*.py /handler.py /aivyla_preview.py /aivyla_output_upload.py \
 && python -c "import runpy; scope = runpy.run_path('/handler.py', run_name='aivyla_preview_build_check'); assert callable(scope['handler']); assert 'PreviewPublisher' in scope; print('PASS: preview handler import and dependencies')"

ENV AIVYLA_FAST_REQUIREMENTS=1 \
    AIVYLA_R2_ENABLED=0 AIVYLA_R2_NODES_ENABLED=0 \
    AIVYLA_R2_BUCKET=aivyla-models-usa AIVYLA_R2_CATALOG_TTL=60 \
    AIVYLA_R2_DOWNLOAD_STREAMS=12 AIVYLA_R2_PARALLEL_MODELS=2 \
    AIVYLA_R2_FALLBACK=0 AIVYLA_R2_NODE_PIP=0 \
    AIVYLA_R2_PRUNE_UNUSED=1 AIVYLA_R2_SKIP_OBJECT_INFO=1 \
    AIVYLA_LIVE_PREVIEW_ENABLED=false \
    AIVYLA_TRUSTED_RECEIPTS_PATH=/opt/aivyla-global/aivyla_trusted_receipts.json

CMD ["python", "/opt/aivyla-global/aivyla_fast_start.py"]
