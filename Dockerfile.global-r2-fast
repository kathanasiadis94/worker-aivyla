# Isolated Aivyla Global FastStart test image.
# Uses the existing Global v3 base; never updates the Main production image/tag.
FROM ghcr.io/kathanasiadis94/worker-aivyla:aivyla-global-v3

RUN python -m pip install --no-cache-dir 'boto3>=1.34,<2' \
 && python -m pip check

# Preserve the existing R2/CDN/FastStart bootstrap and model/node staging.
COPY aivyla_r2_registry.py aivyla_r2_stage.py aivyla_cdn_stage.py aivyla_cdn_v2_stage.py aivyla_r2_nodes.py aivyla_global_r2_handler.py aivyla_global_r2_start.py aivyla_global_nodes.py aivyla_fast_requirements.py aivyla_fast_start.py /opt/aivyla-global/

# IMPORTANT: The v3 base image has an older /handler.py. Explicitly overlay
# the preview-aware handler and its dependencies in THIS Global image only.
# /opt/aivyla-global/aivyla_global_r2_handler.py loads /handler.py at runtime.
COPY handler.py aivyla_preview.py aivyla_output_upload.py /

# Syntax + handler import smoke test during image build (before publishing).
RUN python -m py_compile /opt/aivyla-global/*.py /handler.py /aivyla_preview.py /aivyla_output_upload.py \
 && python -c "import runpy; scope = runpy.run_path('/handler.py', run_name='aivyla_preview_build_check'); assert callable(scope['handler']); assert 'PreviewPublisher' in scope; print('PASS: preview handler import and dependencies')"

ENV AIVYLA_FAST_REQUIREMENTS=1 \
    AIVYLA_R2_ENABLED=0 AIVYLA_R2_NODES_ENABLED=0 \
    AIVYLA_R2_BUCKET=aivyla-models AIVYLA_R2_CATALOG_TTL=60 \
    AIVYLA_R2_DOWNLOAD_STREAMS=12 AIVYLA_R2_PARALLEL_MODELS=2 \
    AIVYLA_R2_FALLBACK=1 AIVYLA_R2_NODE_PIP=0 \
    AIVYLA_R2_PRUNE_UNUSED=1 AIVYLA_R2_SKIP_OBJECT_INFO=1 \
    AIVYLA_LIVE_PREVIEW_ENABLED=false

CMD ["python", "/opt/aivyla-global/aivyla_fast_start.py"]
