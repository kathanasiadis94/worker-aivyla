# syntax=docker/dockerfile:1.7
# OPTIONAL candidate: requires a local verified bundle in assets/ (one-time).
# Strongly prefer measuring the image-pull tradeoff before using this variant.
FROM ghcr.io/kathanasiadis94/worker-aivyla:aivyla-global-v3
RUN python -m pip install --no-cache-dir 'boto3>=1.34,<2' \
 && python -m pip check
COPY aivyla_r2_registry.py aivyla_r2_stage.py aivyla_r2_nodes.py aivyla_global_r2_handler.py aivyla_global_r2_start.py aivyla_global_nodes.py aivyla_fast_requirements.py aivyla_fast_start.py /opt/aivyla-global/
COPY assets/custom_nodes_bundle_v1.tar.gz /tmp/aivyla-custom-nodes.tar.gz
RUN <<'SH'
set -eu
echo '0f6d600452d04020fbe97886c657eb48ca6fc8ba6a548906193d0e419623c6cc  /tmp/aivyla-custom-nodes.tar.gz' | sha256sum -c -
python - <<'PY'
from pathlib import Path, PurePosixPath
import tarfile
archive = Path('/tmp/aivyla-custom-nodes.tar.gz')
root = Path('/opt/aivyla-global/baked-nodes')
root.mkdir(parents=True, exist_ok=True)
with tarfile.open(archive, 'r:gz') as src:
    members = src.getmembers()
    for member in members:
        p = PurePosixPath(member.name)
        assert p.parts and not p.is_absolute() and '..' not in p.parts, member.name
        assert member.isfile() or member.isdir(), member.name
    src.extractall(path=root, members=members, filter='data')
nodes = sorted(p for p in root.iterdir() if p.is_dir() and (p/'__init__.py').is_file())
assert len(nodes) == 16, f'Expected 16 bundled nodes, got {len(nodes)}'
(root/'.aivyla-node-bundle-sha256').write_text('0f6d600452d04020fbe97886c657eb48ca6fc8ba6a548906193d0e419623c6cc\n')
print('Verified baked nodes:', len(nodes))
PY
rm /tmp/aivyla-custom-nodes.tar.gz
python -m py_compile /opt/aivyla-global/*.py
SH
ENV AIVYLA_FAST_BAKED_NODES=1 AIVYLA_FAST_REQUIREMENTS=1 \
    AIVYLA_R2_ENABLED=0 AIVYLA_R2_NODES_ENABLED=0 \
    AIVYLA_R2_BUCKET=aivyla-models AIVYLA_R2_CATALOG_TTL=60 \
    AIVYLA_R2_DOWNLOAD_STREAMS=12 AIVYLA_R2_PARALLEL_MODELS=2 \
    AIVYLA_R2_FALLBACK=1 AIVYLA_R2_NODE_PIP=0 \
    AIVYLA_R2_PRUNE_UNUSED=1 AIVYLA_R2_SKIP_OBJECT_INFO=1
CMD ["python", "/opt/aivyla-global/aivyla_fast_start.py"]
