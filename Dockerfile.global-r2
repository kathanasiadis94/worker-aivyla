# Separate, experimental image. Production and Global v3 tags remain unchanged.
FROM ghcr.io/kathanasiadis94/worker-aivyla:aivyla-global-v3
RUN python -m pip install --no-cache-dir 'boto3>=1.34,<2' \
 && python -m pip check
COPY aivyla_r2_registry.py /opt/aivyla-global/aivyla_r2_registry.py
COPY aivyla_r2_stage.py /opt/aivyla-global/aivyla_r2_stage.py
COPY aivyla_r2_nodes.py /opt/aivyla-global/aivyla_r2_nodes.py
COPY aivyla_global_nodes.py /opt/aivyla-global/aivyla_global_nodes.py
COPY aivyla_global_r2_handler.py /opt/aivyla-global/aivyla_global_r2_handler.py
COPY aivyla_global_r2_start.py /opt/aivyla-global/aivyla_global_r2_start.py
RUN python -m py_compile /opt/aivyla-global/*.py
ENV AIVYLA_R2_ENABLED=0 AIVYLA_R2_NODES_ENABLED=0 \
    AIVYLA_R2_BUCKET=aivyla-models AIVYLA_R2_CATALOG_TTL=60 \
    AIVYLA_R2_DOWNLOAD_STREAMS=8 AIVYLA_R2_PARALLEL_MODELS=2 \
    AIVYLA_R2_FALLBACK=1 AIVYLA_R2_NODE_PIP=0
CMD ["python", "/opt/aivyla-global/aivyla_global_r2_start.py"]
